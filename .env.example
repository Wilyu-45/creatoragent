# ===== 服务端 =====
PORT=8787

# ===== LLM 提供方 =====
# mock    : 内置离线模拟引擎，无需任何密钥即可跑通全流程（默认）
# openai  : 任意 OpenAI 兼容接口（OpenAI / DeepSeek / 通义 / 豆包 / 本地 vLLM / Ollama）
LLM_PROVIDER=mock

# OpenAI 兼容配置（LLM_PROVIDER=openai 时生效，也可在 Web 界面「设置」中填写）
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# 生成参数
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=2048
LLM_TIMEOUT_MS=60000

# ===== 编排与门禁 =====
# 单任务 Turn Budget（最大智能体调用次数），命中后转人工
TURN_BUDGET=25
# 最大返工轮次
MAX_REVISIONS=2
# 编辑质量分门禁阈值（0-100）
QUALITY_THRESHOLD=75
# 是否跳过人工审批（演示用）
AUTO_APPROVE=false
