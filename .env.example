# ===== 服务端 =====
PORT=8787
# 监听地址：默认 127.0.0.1（仅本机，配合反向代理使用，见 DEPLOYMENT.md）。
# 容器部署由镜像/清单显式设为 0.0.0.0（端口发布要求监听非 loopback）；
# 局域网直连同样设 0.0.0.0 —— 暴露到本机以外前务必设置 CREATOR_API_TOKENS。
HOST=127.0.0.1
# 持久化目录（容器部署时会指向挂载卷，如 /data）
# CREATOR_DATA_DIR=/data

# ===== 存储层（file / PostgreSQL + Redis）=====
# file（默认）：JSON 文件 + SQLite 检查点，零依赖、离线可跑，单副本
# pg          ：任务/黑板/记忆库/评估/数字人作业入 PostgreSQL，意图租约入 Redis，
#               断点检查点用 PostgresSaver —— 支持多副本横向扩展（契约见 storage_contract.md）
CREATOR_STORAGE=file
# pg 模式的连接串（含密码，勿提交真实值）；docker compose --profile pg 起本地库时用下面的默认值
# CREATOR_DATABASE_URL=postgresql://creator:creator@localhost:5432/creator
# CREATOR_REDIS_URL=redis://localhost:6379/0
# Redis key 前缀（多套环境共用一个 Redis 时区分）
# CREATOR_REDIS_PREFIX=creator:
# 连接池（一般不用改）
# CREATOR_PG_POOL_MIN=1
# CREATOR_PG_POOL_MAX=8
# CREATOR_PG_CONNECT_TIMEOUT=5

# ===== LLM 提供方 =====
# mock    : 内置离线模拟引擎，无需任何密钥即可跑通全流程（默认）
# openai  : 任意 OpenAI 兼容接口（OpenAI / DeepSeek / 通义 / 豆包 / 本地 vLLM / Ollama）
LLM_PROVIDER=mock

# OpenAI 兼容配置（LLM_PROVIDER=openai 时生效，也可在 Web 界面「设置」中填写）
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# 生成参数
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=2048
LLM_TIMEOUT_MS=60000
# DeepSeek 思考模式（enabled/disabled，默认 disabled）：思考模式下思维链按 output
# 价计费、temperature 不生效，长提示词下会耗尽 max_tokens 导致 content 为空。
# 仅 DeepSeek 网关识别该字段，其他 OpenAI 兼容实现忽略。
LLM_THINKING=disabled

# ===== 多模态素材输入（plan.md v2.0）=====
# Brief.assets 中的图片是否作为多模态内容块发给模型。
# 默认 false：主流 OpenAI 兼容文本模型（deepseek-chat/flash、qwen-plus、
# 本地 Ollama 文本模型等）收到图片块会直接 400，且不可重试。
# 确认模型支持读图（如 gpt-4o / qwen-vl / glm-4v）后再打开。
LLM_VISION=false
# 单次创作最多注入的图片数（按图片计费，且会挤占文本预算）
LLM_VISION_MAX_IMAGES=6

# ===== 本地素材目录 =====
# 素材里写相对文件名时，只在 <CREATOR_DATA_DIR>/assets/ 下查找；
# 绝对路径与 .. 越界一律拒绝（Brief 可来自 API 调用方，不能当文件读取原语用）。

# ===== 编排与门禁 =====
# 单任务 Turn Budget（最大智能体调用次数），命中后转人工
TURN_BUDGET=25
# 最大返工轮次
MAX_REVISIONS=2
# 编辑质量分门禁阈值（0-100）
QUALITY_THRESHOLD=75
# 是否跳过人工审批（演示用）
AUTO_APPROVE=false

# ===== 成本熔断与缓存 =====
# 单任务成本上限（美元），超出即熔断到离线引擎
COST_BUDGET_USD=0.5
# 单任务 token 上限
TOKEN_BUDGET=50000
# 是否启用 LLM 响应缓存
LLM_CACHE=true

# ===== 记忆库向量检索（A11 的 RAG）=====
# local  : 本地确定性 hashing embedding（零依赖、可离线，默认）
# openai : 任意 OpenAI 兼容 /embeddings（远端失败自动回退本地向量）
EMBEDDING_PROVIDER=local
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=256
# 混合检索中语义分量的权重：0 = 纯关键词（与历史行为一致）
EMBEDDING_WEIGHT=0.35

# ===== 发布投递（多平台自动发布）=====
# 系统不内置各平台私有 SDK：到点把「该投什么」POST 给该地址（可对接 n8n/Zapier/自建网关）
# 留空时「投递」等价于「登记发布」，离线同样可用
PUBLISH_WEBHOOK_URL=
PUBLISH_RETRY=2
# 是否由后台定时器自动投递到期排期
PUBLISH_AUTO_DISPATCH=false
PUBLISH_TICK_SECONDS=60

# ===== 质量评估（LLM-as-a-Judge）=====
# off = 不评估；advisory = 只打分不影响门禁（默认）；blocking = 低分参与返工判定
JUDGE_MODE=advisory
# offline = 确定性规则评估器（可复现，默认）；llm = 走模型网关（失败自动回退 offline）
JUDGE_PROVIDER=offline
JUDGE_MODEL=
# 评估通过线（0-100）
JUDGE_PASS_THRESHOLD=75
# 评估分在综合质量分中的权重：0 = 完全不影响（可回滚）
JUDGE_WEIGHT=0.2

# ===== 分布式追踪（OTLP 导出）=====
# 留空 = 只做进程内追踪（span 树 + data/traces/*.json），不加载 OTel SDK
# 配置后把同一份 span（相同 trace_id/span_id）转发给 collector
# 本地一键起 Jaeger：docker compose up -d  然后打开 http://127.0.0.1:16686
OTLP_ENDPOINT=
OTEL_SERVICE_NAME=creator-agent-studio
# 形如 key1=value1,key2=value2（带鉴权的托管 collector 用）
OTLP_HEADERS=
# 采样器（与 OTel 语义对齐）：parentbased_always_on（默认）/ parentbased_always_off /
# parentbased_traceidratio / always_on / always_off / traceidratio
# 采样只作用于导出面（OTLP + 落盘）；进程内轨迹始终完整
OTEL_TRACES_SAMPLER=parentbased_always_on
# traceidratio 的采样比例（0-1）；入站 traceparent 的采样标记优先于本地比例
OTEL_TRACES_SAMPLER_ARG=1.0

# ===== 数字人渲染（开发样例，可选）=====
# 数字人渲染不在本系统内实现：这里提供的是接入样例，接哪家（HeyGen / D-ID / 腾讯智影 /
# 自建渲染农场…）由你决定。任务产出视频脚本后，前端会出现「数字人渲染」面板。
# sample = 内置样例引擎（默认）：离线模拟「排队 → 渲染 → 完成」并生成渲染清单
# http   = 通用适配样例：对接「POST 建任务 → GET 查状态」最小契约的自建网关
DIGITAL_HUMAN_PROVIDER=sample
# http 样例的远端网关地址（留空时 http provider 会显式失败，绝不假装成功）
DIGITAL_HUMAN_API_URL=
# 网关鉴权（按 Bearer 携带，可留空）
DIGITAL_HUMAN_API_KEY=
# 默认形象 ID（创建作业时可被请求体覆盖）
DIGITAL_HUMAN_AVATAR=
# 单次 HTTP 请求超时（毫秒）
DIGITAL_HUMAN_TIMEOUT_MS=10000

# ===== 图片生成（开发样例，可选；见 app/core/imagegen.py）=====
# 让 A8 从「只出 image_prompts」升级到「真出封面/分镜画面」，服务解说视频封面与 B-roll 静帧。
# 图片生成不在本系统内实现，这里只提供接入样例，未配置真实端点时显式失败、绝不假装成功。
# sample  = 内置样例引擎（默认）：离线确定性模拟「排队 → 生成 → 完成」，
#           按 visual_brief 的 image_prompts 出「生成清单」（不产真图，保证联调与回归）
# openai  = 对接 OpenAI 协议 POST {base_url}/images/generations（覆盖经网关的即梦/通义万相/Replicate 等）
# local   = 对接本地图生网关 POST {base_url}/sdapi/v1/txt2img（A1111 / SD-WebUI 同步接口；
#           ComfyUI 需前置一个同构的同步网关）
IMAGEGEN_PROVIDER=sample
# openai/local 的端点根地址（openai 自动补 /images/generations，local 补 /sdapi/v1/txt2img）
IMAGEGEN_BASE_URL=
# 鉴权密钥（openai 以 Bearer 拼接；local 可选，勿提交真实值）
IMAGEGEN_API_KEY=
# 模型标识（openai 生效；留空用网关默认）
IMAGEGEN_MODEL=
# 出图尺寸（openai size 字段；local 用作宽高）
IMAGEGEN_SIZE=1024x1024
# 单次作业最多生成的提示词数（按张计费，防止一次把整批分镜都烧出去，上限 8）
IMAGEGEN_MAX_IMAGES=4
# 单次生成请求超时（毫秒）
IMAGEGEN_TIMEOUT_MS=60000

# ===== 视频生成（开发样例，可选；见 app/core/videogen.py）=====
# 消费 video_script 的分镜清单，按镜产出画面段（逼近「可开拍素材」），不做剪辑合成。
# 与数字人同一哲学：系统不绑厂商，只提供「POST 建任务 → GET 查状态」最小契约的接入样例。
# 任务须先产出 video_script（B 站等 VIDEO_CHANNELS 渠道会自动出），否则建作业返回 409。
# sample = 内置样例引擎（默认）：离线确定性模拟生命周期，按分镜出「渲染清单」
# http   = 通用适配样例：按 VIDEOGEN_API_URL 启用，云端视频网关（可灵/即梦/Runway…）
#          或自建本地渲染农场（本地端点自动计 0 元）均可
VIDEOGEN_PROVIDER=sample
# http 样例的建任务端点（POST）；留空时 http provider 会显式失败，绝不假装成功
VIDEOGEN_API_URL=
# 调用上述端点的鉴权头（以 Bearer 前缀拼接，可留空）
VIDEOGEN_API_KEY=
# 本地视频生成贵，纳入成本熔断：估算成本超 COST_BUDGET_USD 时 fail-loud、不提交不降级
VIDEOGEN_TIMEOUT_MS=30000

# ===== 视频理解（开发样例，可选；见 app/core/videounderstand.py）=====
# 「看懂画面」的摄取侧能力（digest.py 文档理解的镜像）：把**整集视频**交给**原生支持
# 视频输入的理解网关**（一集=一次调用，成本可控、贴「逐集理解再创作」节奏）→
# 产出该集「视觉摘要」，再一键注入 Brief 驱动创作。与视频生成同一 POST/GET 异步契约。
# 理解推理不在系统内实现，也不绑厂商：厂商私有协议（Gemini 视频输入/自建视频理解农场等）由你的网关层消化。
# 任务须先在 Brief.assets 带一条视频素材（kind=video 或带视频扩展名的本地文件），否则 409。
# sample = 内置样例引擎（默认）：离线模拟生命周期，产出带 simulated 标记的占位摘要骨架（不调网关）
# real   = 按 VIDEOUNDERSTAND_API_URL 提交整集、轮询取回摘要；未配网关/非本地文件/超预算均显式失败（不假装看懂）
VIDEOUNDERSTAND_PROVIDER=sample
# real 样例的视频理解端点（POST 提交整集）；留空时 real 会显式失败，绝不假装成功
VIDEOUNDERSTAND_API_URL=
# 调用上述端点的鉴权头（以 Bearer 前缀拼接，可留空）
VIDEOUNDERSTAND_API_KEY=
# 系统不搬运大文件：只把 assets/ 内的视频引用交给网关自取（网关需与素材同机/可达）
# 提交/轮询的单次请求超时（毫秒）；整集预估成本超 COST_BUDGET_USD 时 fail-loud、不提交
VIDEOUNDERSTAND_TIMEOUT_MS=120000

# ===== 灵感冲浪（自主上网找灵感；见 app/core/surf.py）=====
# 解决「创作时缺灵感」：像真人一样上网刷信息流/看视频，把外部信号消化成一批**灵感卡**
#（点子/切入角度/开场钩子/为什么现在火/参考链接），沉淀成跨任务的**灵感 idea 库**，
# 由用户自行勾选、调整后再「注入 Brief」喂给创作——灵感不自动交付智能体。
# 消化灵感走系统既有 LLM 网关（LLM_*），不另持端点与密钥；视频可**在线看懂**（SURF_WATCH_VIDEOS，仅 browser）：
# 像真人点播放→播放中一段一段截图→**一组一组**交多模态 LLM 看懂并兼做画面文字 OCR→逐组小结后整段汇总——**不下载视频文件**；
# 标题/简介/UP主/播放量/评论等文字信息 DOM 直抓（抓不到时可由截图 OCR 补），评论按上限逐条收集；
# 未开看视频时，发现的视频链接只作**信号**记录（标题/链接）。
# sample = 默认：零依赖、零外网，离线把主题展开成查询→产确定性占位灵感（自报 simulated=True），
#          API/UI/doctor 回归全链路可跑
# browser = 真·无头浏览器（Playwright）像真人一样浏览：随机节奏刷信息流→用起点站自己的搜索框搜主题→
#          点「下一页/加载更多」接着刷→内容页点开「展开全文」并逐条抓评论区→点进同域条目读一层→（可选）点进视频页在线看。Playwright 为**惰性可选依赖**
#          （默认不装），未安装/未配白名单即**受理点名诚实失败**：
#          pip install playwright && playwright install chromium
# http    = 复用系统既有联网检索网关（WEB_SEARCH_*）做轻量冲浪；未配检索即诚实失败点名 WEB_SEARCH_API_URL
# auto    = 按 browser→http→sample 择优（Playwright 可用则 browser，搜索网关已配则 http，否则 sample 并写明）
SURF_PROVIDER=sample
# browser 通道无头开关（false = 可见窗口，本机调试用）
SURF_HEADLESS=true
# 安全：browser 只访问这些白名单域名（逗号分隔）；复用 web.py 的 SSRF 私网/环回拒绝口径，空 = browser 拒绝冲浪
SURF_ALLOWED_DOMAINS=
# browser 通道冲浪起点（白名单内的公开 URL，逗号分隔）
SURF_SEED_SITES=
# 后台自主冲浪囤灵感的主题清单（逗号分隔）；无主题会话时的回退来源
SURF_TOPICS=
# 单次会话最多**访问**的页面数（起点站首页 + 站内搜索结果页 + 点「下一页」翻出的列表后续页 +
# 信息流点进的条目页 + 在线看的视频页合计不越此上限）/ browser 每页下滑轮数 /
# 每轮停留毫秒（开了真人节奏会在此上下浮动）/ 单次请求超时毫秒
SURF_MAX_PAGES=6
SURF_SCROLL_ROUNDS=3
SURF_SETTLE_MS=1200
SURF_TIMEOUT_MS=30000
# 每个主题展开的搜索查询数 / 每次会话消化产出灵感卡上限
SURF_QUERIES_PER_TOPIC=3
SURF_CARDS_PER_SESSION=5
# 灵感池跨任务保留的卡片上限（超出按新旧裁剪）
SURF_POOL_MAX=200
# 是否由后台定时器自主冲浪囤灵感（默认关闭以保持进程零副作用、无外网连接）与检查间隔（秒）
SURF_AUTO_ENABLED=false
SURF_TICK_SECONDS=3600
# 「看懂视频」（像真人一样**在线观看**，仅 browser 通道）：进视频页→点开始播放按钮→确认画面在推进→
# 播放中一段一段截图→**一组一组**交多模态 VLM（每组一次调用，逐组小结）→再整段汇总成观看结论；
# 全程**不下载视频文件**。默认关；未装 Playwright / 未配读图网关（LLM_VISION）时绝不假装看懂：
# 只截帧不交模型，画面摘要自报 simulated=True 与 vision_skipped=True。
SURF_WATCH_VIDEOS=false
# 每个视频播放中截取的总帧数 / 两次截图的间隔毫秒 / 单会话最多看懂几个视频
SURF_VIDEO_FRAMES=8
SURF_VIDEO_FRAME_INTERVAL_MS=1200
SURF_MAX_VIDEOS_PER_SESSION=2
# 每组交 VLM 的截图张数（真人是一段一段看的：N 帧分 M 组，逐组看懂后汇总；与网关单次图片上限取小）
SURF_VLM_GROUP_FRAMES=4
# 截图范围：true = 只截播放器画面元素（含 iframe 内的播放器，省 token 且不受页面干扰）；false = 整页截图
SURF_CROP_TO_VIDEO=true
# 是否抓取视频页的文字信息（标题/简介/UP主/播放量/评论，DOM 直抓）；DOM 抓不到时再截**整页图**交模型逐字转写（截图 OCR 兜底，需 LLM_VISION）
SURF_SCRAPE_COMMENTS=true
# 每个视频页最多收集多少条评论（先滚动触发懒加载，再逐条取内容并按上限截断；评论文字一律真实，不编造）
SURF_MAX_COMMENTS=12
# 是否像真人一样从信息流/页面里点进视频页再看（false = 只看 API 显式传入的视频页链接）
SURF_CLICK_INTO_VIDEOS=true
# ---- 真人式浏览（仅 browser 通道；这几项让浏览不像脚本）----
# 随机节奏：每轮下滑幅度（0.55–1.9×1200px）与停留（0.4–1.9×SURF_SETTLE_MS）随机浮动，
# 偶尔原地停一下把这段读完再滚；false = 等距滚动 + 固定等待的机器节奏。
# 随机源按「主题 + 起点站」播种，同一轮重跑节奏一致（doctor 回归可断言），换主题就换一套。
SURF_HUMAN_PACE=true
# 站内搜索：像真人那样用**起点站自己的搜索框**逐字打字（每键 45–150ms）搜本次主题，回车后读结果页。
# 找不到搜索框 / 打不进字 / 回车与提交按钮都没触发 / 回车后页面没变 / 结果页越出白名单
# —— 一律**如实写明没搜**并退回信息流，绝不假装搜过。
SURF_SEARCH_ON_SEEDS=true
# 打字时站点弹出的搜索联想：逐字打完后先读回下拉里的候选词（一次最多 SURF_SUGGESTIONS_MAX 条，1–20），
# 只点**认得出本次主题词**的那一条（同分时保持站点给的顺序），点中了通常直接就跳到那个词的结果页、不再多回一次车；
# 这一版关键词因此是**站点自己的叫法**，记在信号的 suggested 上并写进「本轮浏览说明」。
# 一条都认不出就照原词回车——**绝不为了点一条联想把主题改成站点更想让我们搜的东西**；联想项点不动（那种只有样式、
# 没有点击处理的下拉）就退回把那个词打回搜索框再回车；这站根本没弹下拉就一个字都不提，绝不凭空造一条建议。
# false = 连下拉都不读一眼，打完原词直接回车；SURF_TOPIC_FOCUS=false 时没有主题词可认，也一样只按原词搜。
SURF_USE_SUGGESTIONS=true
# 一次最多读回几条联想候选（各站下拉长度不同，默认 8 条就够了）
SURF_SUGGESTIONS_MAX=8
# 读到门口就退出来：真人看到「请先登录 / 开通会员 / 我不是机器人 / 页面不存在」就走了，不会把门上的话当内容读。
# 一页正文短到像一扇门（≤600 字）且标题或开头出现墙话，就标上 wall（登录墙/订阅墙/人机验证/维护/出错页）、
# 摘录只留门口那几句话，并写进「本轮浏览说明」有几页被挡住——**不绕墙**（不试验证码、不猜登录 cookie），
# 也不把墙话当正文交给消化模型；被挡的页不算「上几轮读过的页」，下一轮还会再试。
# 正常长文章里顺口提一句「登录后可同步收藏」不会误判成墙；false = 一律照正文读（墙话也会进摘录）。
SURF_AVOID_WALLS=true
# 搜不对题就换个说法再搜：结果页标题里一个主题词都认不出，就**清空搜索框**把话说短重打一轮再搜（0 = 整句搜一次就完，上限 3）。
# 换的词只从本次主题里切出来（整句 → 按标点切开的词组 → 最前面一两个词），**绝不凭空造同义词**；换到贴题为止，
# 再没有更短的说法就照旧读最后一版并在「本轮浏览说明」里如实交代没搜出对题的东西——**没搜到就绝不写「才搜到」**。
# 搜过的每一版关键词都记在信号的 query / search_tried 上；SURF_TOPIC_FOCUS=false 时没有可判的，自动退回只搜一次。
SURF_SEARCH_RETRIES=1
# 信息流多跳：每页从条目里挑几条**普通内容页**点进去读一层（同域优先；0 = 只看当前页不点进）。
# 视频链接不在这里点（走 SURF_WATCH_VIDEOS 的在线看路径）；图片/压缩包/文档直链与白名单外链接一律不收。
SURF_HOPS_PER_PAGE=2
# 扫标题挑条目：同域条目按「标题里认出几个主题词」排序，认得出的先点进去，命中的词写进信号的 picked_for。
# 主题切词不引分词器与外部词表（中文两字滑窗 + 西文按词）；标题里的年份/数量只加分、不记名为主题词。
# 整版一个都认不出时照样按列表原顺序读几条，只在「本轮浏览说明」里如实写明是顺路读的；false = 退回纯列表顺序。
# 要在线看的视频也一样按标题挑：信息流里的视频链接连标题一起读回再排序，贴主题的才排进看片队列，
# 视频信号同样带 listed_as（列表里看到的标题）与 picked_for（凭哪几个词点进去）；一条都没认出就按页面顺序看并说明是顺路看到的。
SURF_TOPIC_FOCUS=true
# 列表翻页：真人不会只看第一页——点**站点自己的**「下一页 / 加载更多」接着刷，一个列表最多刷几页
# （1 = 只看第一页）。只点页面里真存在的控件，**不硬拼 ?page=2 这种伪链接**：没这个控件、点了页面
# 没变化（无限滚动/已到末页）、翻过去落到白名单外、页数预算用尽——一律如实停下并写进「本轮浏览说明」。
# 每翻一页都算进 SURF_MAX_PAGES 的共用预算。
SURF_LIST_PAGES=2
# 展开全文与评论区：内容页先点开「展开全文/展开更多/Read more」再读（不点只抓得到被截断的第一段），
# 并像真人那样翻到底**逐条抓评论区**（评论一律是页面 DOM 里的网友原话，抓不到就留空，绝不编造）。
SURF_PAGE_COMMENTS=true
# 开新页之前的停顿基准毫秒（真人是「看一眼、想一下、再点」；SURF_HUMAN_PACE 开启时在此上下浮动，0 = 不停）。
# 会话第一页与同页继续读（搜索结果页、翻页后的列表页）不会硬停；每条文本信号记 gap_ms 供核对。
SURF_PAGE_GAP_MS=1500
# 读过的不重读（跨会话浏览历史）：这一轮真读进去的条目页/在线看完的视频页按**租户**记下来，
# 下几轮顺路发现的读过的就跳过、改读没见过的新条目（真人刷久了也是这么换着看）。
# 只记**真读到的**：起点站首页、列表/搜索结果页、失败页与浏览说明都不进这份记忆；
# 整版条目上几轮都读过时**照样按页面原顺序重读**并如实说明「没找到没见过的新条目」，
# 用户在 API 里显式指定要看的链接永远照看（这份记忆只拦「顺路发现的」）；仅 browser 通道写这份记忆。
SURF_REMEMBER_READ=true
# 每个租户最多记几页读过的（超了先忘最旧的，20–5000）。关掉 SURF_REMEMBER_READ = 既不记也不跳，
# 每轮都当第一次刷这些站；查看与清空在「灵感冲浪」面板（也可以直接删 data/surf_history.json）。
SURF_HISTORY_MAX=300

# ===== 全自动配音（真实功能；见 app/core/dubbing.py）=====
# 「输入剧情文本 → 自动切分台词、识别说话人 → 引擎逐句合成真音频（落盘、可试听、
# 全 wav 时拼整轨）→ 产出时间轴汇总（每段含源文本与配音，按音频实长重建）」。
# 剧情文本与参考音频都由用户提供；旁路异步作业，引擎通道由后台 worker 推进，
# 服务重启后作业自动复活续跑（已合成句不重复）。缺配置/缺参考音频/超预算显式失败。
# 参考音频只认 assets/ 内的相对路径（或 http(s) 直链），绝对路径与 .. 越界一律拒绝。
# 跨语言译制配音（dubbing 行业本义）：目标语言是**每作业参数**（API targetLang / 面板下拉），
# **无独立环境变量**——翻译复用下方系统既有 LLM 网关（LLM_*/OPENAI_*），不另持端点与密钥；
# 配了真实网关才是真译文，离线引擎只产出占位串并如实标注 translation_simulated（绝不冒充）。
# sample = 离线联调通道：真做切分与识别，但只模拟「排队→合成→完成」（不出真音频）
# auto   = 按 elevenlabs → sovits → sapi → real 取第一个已配置可用的引擎，全没配则回退 sample 并在汇总写明
# sapi   = Windows 系统音色本机真合成（零依赖零费用）；注意：不消费参考音频做克隆，汇总如实标注
# sovits = 自建 GPT-SoVITS api_v2 兼容服务：参考音频零样本克隆，逐句返回 wav（免费离线）
# elevenlabs = 云端 Instant Voice Clone：上传参考音频建音色（每作业每说话人一次）再逐句合成 mp3，按字符计费
# real   = 按 DUBBING_API_URL 把逐句清单提交给你的自定义配音网关（POST 建任务 → GET 查状态）
DUBBING_PROVIDER=sample
# —— sovits 通道：自建克隆服务地址（如 http://127.0.0.1:9880，需与本项目同机/共享文件路径可达）
DUBBING_SOVITS_BASE_URL=
# —— sovits 文本语种（GPT-SoVITS 的 text_lang：zh / en / ja 等）
DUBBING_SOVITS_LANGUAGE=zh
# —— elevenlabs 通道：API 地址与密钥（xi-api-key；私有部署可改地址）与合成模型
DUBBING_ELEVENLABS_BASE_URL=https://api.elevenlabs.io/v1
DUBBING_ELEVENLABS_API_KEY=
DUBBING_ELEVENLABS_MODEL=eleven_multilingual_v2
# —— sapi 通道：限定使用的系统音色（逗号分隔的 VoiceInfo.Name；留空 = 用全部已安装音色；
#    含中文台词时只在 zh-* 音色里选，没有中文音色会显式失败而非交静音成品）
DUBBING_SAPI_VOICES=
# —— real 网关：建任务端点（POST 提交台词清单）；留空时 real 会显式失败，绝不假装成功
DUBBING_API_URL=
# 调用上述端点的鉴权头（以 Bearer 前缀拼接，可留空）
DUBBING_API_KEY=
# 单次请求超时（毫秒）；云端引擎按计费口径预估，超 COST_BUDGET_USD 时受理前熔断、不提交
DUBBING_TIMEOUT_MS=60000
# 单作业最多配音的台词行数（1–1000）：防止整本剧本一次烧出去，超出直接拒绝而非静默截断
DUBBING_MAX_LINES=200
# 合成前的时间轴估算语速（字/秒）；引擎完成后按音频实长重建，估算只用于预览与未回传时长时兜底
DUBBING_CHARS_PER_SECOND=4.5

# ===== 桌面宠物（开发样例，可选；见 app/core/petgen.py + app/desktop_pet.py）=====
# 把 A8 的视觉指导（visual_brief）做成**能跑的桌宠包**：逐动作出帧 → 帧包 + pet.json
# + 内置运行器 zip。旁路异步作业（与图片/视频/数字人同一 POST/GET 契约），不落黑板产物。
# 不做图像处理：无抠图/切帧/对齐，帧按纯色键 #FF00FE 绘制，运行器用 tkinter -transparentcolor 透边
# sample  = 内置样例引擎（默认）：标准库画帧并真实落盘 PNG（清单带 simulated 标记，不假装是模型出的图）
# imagegen= 复用上面的 IMAGEGEN_* 图片通道逐帧出真图（不新增端点/密钥配置）；未配端点显式失败、不降级画帧
PETGEN_PROVIDER=sample
# 单帧边长（像素，32–192）：桌宠常驻桌面，帧小才不吃内存，不做高清大图
PETGEN_FRAME_SIZE=96
# 一次作业最多出多少帧（1–24）：帧数=动作段之和，超上限直接拒绝而不是静默截断
PETGEN_MAX_FRAMES=16
# 单帧出图超时（毫秒）；逐帧累计预估成本超 COST_BUDGET_USD 时受理前熔断、不提交
PETGEN_TIMEOUT_MS=60000

# ===== 创作技能提炼（开发样例，可选；见 app/core/skillgen.py）=====
# 把**你自己喂进任务的作品**（往期成稿 / 文案文档 / 字幕 / 视频脚本 / 整集视频的理解摘要）
# 提炼成可复用的「创作技能」：结构骨架 + 节奏参数 + 检查清单 + 反例 → 扩展插件 skills 目录
# 直接可用的 SKILL.md（+ skill.json + zip），并可一键沉淀成记忆库 template 卡片。
# 旁路异步作业（与图片/视频/桌宠同一 POST/GET 契约），不落黑板产物。
# 风格判断不在系统内实现硬编码规则库，两条通道按诚实边界分工：
# rules = 量化提炼（默认，零 token）：句长 / 段落 / 疑问句与人称占比 / 字幕语速**真统计**自作品正文，
#         每条结论带证据；不含模型推理，故产物 simulated=true 并在正文写明
# llm   = 复用上面的 LLM_* 网关做一次结构化提炼（不新增端点/密钥）；未配真实网关显式失败，绝不假装提炼
SKILLGEN_PROVIDER=rules
# 单次作业最多纳入几份作品（1–20）：超出部分记入 issues，不静默截断
SKILLGEN_MAX_WORKS=12

# ===== 联网检索（可选；A1 策略 / A2 创意 / A3 策划 / A6 事实核查 / A10 数据分析）=====
# 系统不内置搜索服务，只定义最小契约，由你指向自己的搜索网关
# （SerpAPI / Bing / 自建聚合均可）。默认 none = 完全不联网：
# 工具会如实返回「本轮未启用联网」，智能体据此不得声称已联网核实。
# 契约：POST {"query": "...", "max_results": 5}
#       → {"results": [{"title": "...", "url": "https://...", "snippet": "..."}]}
# （results/items/data/organic_results 或直接数组都能识别，字段名兼容 link/description）
WEB_SEARCH_PROVIDER=none
WEB_SEARCH_API_URL=
WEB_SEARCH_API_KEY=
WEB_SEARCH_MAX_RESULTS=8
WEB_SEARCH_TIMEOUT_MS=15000
# 是否允许 page_fetch 抓取检索命中页面的正文（仅 http/https 公开页面；
# 私网/环回/云元数据地址一律拒绝）
WEB_SEARCH_FETCH_PAGES=true
WEB_SEARCH_MAX_PAGES=4

# ===== API 鉴权与租户隔离 =====
# 留空 = 不鉴权（单机零配置）。配置后 /api/* 需携带令牌，且任务与记忆库按租户隔离
# 单租户：tok_abc123      多租户：acme:tok_aaa,beta:tok_bbb
CREATOR_API_TOKENS=

# ===== MCP 插件（python -m app.mcp_server，让 DeepSeek harness / Claude Code / Trae 等 agent 使用本项目）=====
# MCP 进程是 REST API 的协议适配层，状态唯一归属主服务；以下都是 MCP 进程自己的环境变量
# 上游 Creator 服务地址（stdio 模式必需服务已启动；HTTP 模式同理指向它）
CREATOR_MCP_BASE_URL=http://127.0.0.1:8787
# stdio 模式的固定令牌（HTTP 模式优先透传调用方请求自带的 Authorization / X-API-Token）
# 上游配置了 CREATOR_API_TOKENS 时，让 harness 通过环境变量携带同一令牌
CREATOR_MCP_TOKEN=
# HTTP 传输监听地址与端口（python -m app.mcp_server --http）
# 暴露到本机以外前务必给上游服务配置 CREATOR_API_TOKENS（租户判定在上游完成）
CREATOR_MCP_HOST=127.0.0.1
CREATOR_MCP_PORT=8766
